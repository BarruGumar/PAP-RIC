# Copiar para .env e ajustar. Nunca commitar .env.

RIC_HOST=127.0.0.1
RIC_PORT=8787
RIC_DATA_DIR=./ric-data
RIC_DEBUG=0

# Reminder retries (default A+D da arquitetura)
RIC_REMINDER_MAX_ALERTS=3
RIC_REMINDER_RETRY_MINUTES=2

# TTS Piper
# Default estável (não precisa de linha): ric-data/vozes/pt_PT-tugao-medium.onnx
# Para TESTAR outra voz sem apagar o default, mete o .onnx em ric-data/vozes/extras/
# e descomenta (depois comenta outra vez para voltar):
# RIC_PIPER_MODEL=./ric-data/vozes/extras/OUTRA-voz.onnx
# RIC_PIPER_BIN=
# >1 = mais lento. 1.35 ≈ natural; acima de ~1.5 pode “travar”
RIC_PIPER_LENGTH_SCALE=1.35

# Telegram (etapa 3) — opcional
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
